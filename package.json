{
  "name": "frappe_ai",
  "version": "0.0.1",
  "private": true,
  "description": "Runtime deps for the frappe_ai bundle (resolved by Frappe's esbuild).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.8",
    "typescript": "~5.6",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.9"
  }
}
